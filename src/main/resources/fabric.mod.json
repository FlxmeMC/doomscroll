{
  "schemaVersion": 1,
  "id": "doomscrolling",
  "version": "${version}",
  "name": "Doomscroll",
  "description": "Watch YouTube Shorts right inside Minecraft. Drag, resize, and scroll without leaving the game.",
  "authors": [
    "xFlxme"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/doomscrolling",
    "sources": "https://github.com/FlxmeMC/doomscroll",
    "issues": "https://github.com/FlxmeMC/doomscroll/issues"
  },
  "license": "MIT",
  "icon": "assets/doomscrolling/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.doomscrolling.DoomscrollingClient"
    ],
    "modmenu": [
      "dev.doomscrolling.compat.ModMenuIntegration"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*",
    "rinku": ">=3.0.0"
  },
  "suggests": {
    "modmenu": "*"
  }
}
